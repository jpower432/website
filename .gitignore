# Jekyll build artifacts
_site/
.jekyll-cache/
.jekyll-metadata
.jekyll/
vendor/
.bundle/
node_modules/

# Compiled CSS (generated from style.scss)
assets/css/*.css
assets/css/*.css.map
!assets/css/style.css
!assets/css/style.css.map

# Generated schema documentation (produced by the spec repo's gendocs pipeline)
schema/*.md
!schema/index.md
model/02-definitions.md
